# VocalLabs AgentFlow Environment Variables

# Nhost & Hasura GraphQL Configuration
NEXT_PUBLIC_NHOST_SUBDOMAIN=local
NEXT_PUBLIC_NHOST_REGION=local
NEXT_PUBLIC_HASURA_GRAPHQL_URL=http://localhost:8080/v1/graphql
HASURA_GRAPHQL_ADMIN_SECRET=myadminsecretkey

# Optional Real LLM API Key (Gemini, OpenRouter, Groq)
# If omitted, system seamlessly runs in realistic LLM fallback mode with 800ms artificial delay
GEMINI_API_KEY=
