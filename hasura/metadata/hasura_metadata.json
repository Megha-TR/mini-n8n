{
  "resource_version": 3,
  "metadata": {
    "version": 3,
    "sources": [
      {
        "name": "default",
        "kind": "postgres",
        "tables": [
          {
            "table": { "schema": "public", "name": "organizations" },
            "object_relationships": [],
            "array_relationships": [
              { "name": "members", "using": { "foreign_key_constraint_on": { "table": { "schema": "public", "name": "org_members" }, "column": "org_id" } } },
              { "name": "workflows", "using": { "foreign_key_constraint_on": { "table": { "schema": "public", "name": "workflows" }, "column": "org_id" } } },
              { "name": "data_records", "using": { "foreign_key_constraint_on": { "table": { "schema": "public", "name": "data_records" }, "column": "org_id" } } }
            ],
            "computed_fields": [
              {
                "name": "usage_summary",
                "definition": {
                  "table_argument": "o",
                  "function": { "schema": "public", "name": "org_usage_summary" }
                }
              }
            ],
            "select_permissions": [
              {
                "role": "owner",
                "permission": {
                  "columns": ["id", "name", "calls_used", "max_calls_allowed", "created_at", "updated_at"],
                  "filter": { "members": { "user_id": { "_eq": "X-Hasura-User-Id" }, "role": { "_eq": "owner" } } }
                }
              },
              {
                "role": "editor",
                "permission": {
                  "columns": ["id", "name", "calls_used", "max_calls_allowed", "created_at", "updated_at"],
                  "filter": { "members": { "user_id": { "_eq": "X-Hasura-User-Id" }, "role": { "_in": ["owner", "editor"] } } }
                }
              },
              {
                "role": "viewer",
                "permission": {
                  "columns": ["id", "name", "calls_used", "max_calls_allowed", "created_at", "updated_at"],
                  "filter": { "members": { "user_id": { "_eq": "X-Hasura-User-Id" } } }
                }
              }
            ]
          },
          {
            "table": { "schema": "public", "name": "org_members" },
            "object_relationships": [
              { "name": "organization", "using": { "foreign_key_constraint_on": "org_id" } },
              { "name": "user", "using": { "foreign_key_constraint_on": "user_id" } }
            ],
            "select_permissions": [
              {
                "role": "owner",
                "permission": {
                  "columns": ["id", "org_id", "user_id", "role", "created_at"],
                  "filter": { "organization": { "members": { "user_id": { "_eq": "X-Hasura-User-Id" }, "role": { "_eq": "owner" } } } }
                }
              },
              {
                "role": "editor",
                "permission": {
                  "columns": ["id", "org_id", "user_id", "role", "created_at"],
                  "filter": { "organization": { "members": { "user_id": { "_eq": "X-Hasura-User-Id" } } } }
                }
              },
              {
                "role": "viewer",
                "permission": {
                  "columns": ["id", "org_id", "user_id", "role", "created_at"],
                  "filter": { "organization": { "members": { "user_id": { "_eq": "X-Hasura-User-Id" } } } }
                }
              }
            ],
            "insert_permissions": [
              {
                "role": "owner",
                "permission": {
                  "check": { "organization": { "members": { "user_id": { "_eq": "X-Hasura-User-Id" }, "role": { "_eq": "owner" } } } },
                  "columns": ["org_id", "user_id", "role"]
                }
              }
            ]
          },
          {
            "table": { "schema": "public", "name": "workflows" },
            "object_relationships": [
              { "name": "organization", "using": { "foreign_key_constraint_on": "org_id" } }
            ],
            "array_relationships": [
              { "name": "steps", "using": { "foreign_key_constraint_on": { "table": { "schema": "public", "name": "workflow_steps" }, "column": "workflow_id" } } },
              { "name": "triggers", "using": { "foreign_key_constraint_on": { "table": { "schema": "public", "name": "workflow_triggers" }, "column": "workflow_id" } } },
              { "name": "runs", "using": { "foreign_key_constraint_on": { "table": { "schema": "public", "name": "workflow_runs" }, "column": "workflow_id" } } }
            ],
            "select_permissions": [
              {
                "role": "owner",
                "permission": {
                  "columns": ["id", "org_id", "name", "description", "is_active", "created_by", "created_at", "updated_at"],
                  "filter": { "organization": { "members": { "user_id": { "_eq": "X-Hasura-User-Id" }, "role": { "_eq": "owner" } } } }
                }
              },
              {
                "role": "editor",
                "permission": {
                  "columns": ["id", "org_id", "name", "description", "is_active", "created_by", "created_at", "updated_at"],
                  "filter": { "organization": { "members": { "user_id": { "_eq": "X-Hasura-User-Id" }, "role": { "_in": ["owner", "editor"] } } } }
                }
              },
              {
                "role": "viewer",
                "permission": {
                  "columns": ["id", "org_id", "name", "description", "is_active", "created_by", "created_at", "updated_at"],
                  "filter": { "organization": { "members": { "user_id": { "_eq": "X-Hasura-User-Id" } } } }
                }
              }
            ],
            "insert_permissions": [
              {
                "role": "owner",
                "permission": {
                  "check": { "organization": { "members": { "user_id": { "_eq": "X-Hasura-User-Id" }, "role": { "_eq": "owner" } } } },
                  "columns": ["org_id", "name", "description", "is_active"]
                }
              },
              {
                "role": "editor",
                "permission": {
                  "check": { "organization": { "members": { "user_id": { "_eq": "X-Hasura-User-Id" }, "role": { "_in": ["owner", "editor"] } } } },
                  "columns": ["org_id", "name", "description", "is_active"]
                }
              }
            ]
          },
          {
            "table": { "schema": "public", "name": "workflow_steps" },
            "object_relationships": [
              { "name": "workflow", "using": { "foreign_key_constraint_on": "workflow_id" } }
            ],
            "select_permissions": [
              {
                "role": "owner",
                "permission": {
                  "columns": ["id", "workflow_id", "step_order", "name", "type", "config", "created_at"],
                  "filter": { "workflow": { "organization": { "members": { "user_id": { "_eq": "X-Hasura-User-Id" }, "role": { "_eq": "owner" } } } } }
                }
              },
              {
                "role": "editor",
                "permission": {
                  "columns": ["id", "workflow_id", "step_order", "name", "type", "config", "created_at"],
                  "filter": { "workflow": { "organization": { "members": { "user_id": { "_eq": "X-Hasura-User-Id" }, "role": { "_in": ["owner", "editor"] } } } } }
                }
              },
              {
                "role": "viewer",
                "permission": {
                  "columns": ["id", "workflow_id", "step_order", "name", "type", "config", "created_at"],
                  "filter": { "workflow": { "organization": { "members": { "user_id": { "_eq": "X-Hasura-User-Id" } } } } }
                }
              }
            ],
            "insert_permissions": [
              {
                "role": "owner",
                "permission": {
                  "check": { "workflow": { "organization": { "members": { "user_id": { "_eq": "X-Hasura-User-Id" }, "role": { "_eq": "owner" } } } } },
                  "columns": ["workflow_id", "step_order", "name", "type", "config"]
                }
              },
              {
                "role": "editor",
                "permission": {
                  "check": {
                    "_and": [
                      { "workflow": { "organization": { "members": { "user_id": { "_eq": "X-Hasura-User-Id" }, "role": { "_in": ["owner", "editor"] } } } } },
                      { "type": { "_nin": ["db_write", "webhook", "notify"] } }
                    ]
                  },
                  "columns": ["workflow_id", "step_order", "name", "type", "config"]
                }
              }
            ]
          },
          {
            "table": { "schema": "public", "name": "workflow_runs" },
            "object_relationships": [
              { "name": "workflow", "using": { "foreign_key_constraint_on": "workflow_id" } }
            ],
            "array_relationships": [
              { "name": "step_runs", "using": { "foreign_key_constraint_on": { "table": { "schema": "public", "name": "step_runs" }, "column": "workflow_run_id" } } }
            ],
            "select_permissions": [
              {
                "role": "owner",
                "permission": {
                  "columns": ["id", "workflow_id", "triggered_by_user_id", "trigger_type", "status", "current_step_index", "context_data", "error_message", "started_at", "completed_at", "created_at", "updated_at"],
                  "filter": { "workflow": { "organization": { "members": { "user_id": { "_eq": "X-Hasura-User-Id" } } } } }
                }
              },
              {
                "role": "editor",
                "permission": {
                  "columns": ["id", "workflow_id", "triggered_by_user_id", "trigger_type", "status", "current_step_index", "context_data", "error_message", "started_at", "completed_at", "created_at", "updated_at"],
                  "filter": { "workflow": { "organization": { "members": { "user_id": { "_eq": "X-Hasura-User-Id" } } } } }
                }
              },
              {
                "role": "viewer",
                "permission": {
                  "columns": ["id", "workflow_id", "triggered_by_user_id", "trigger_type", "status", "current_step_index", "context_data", "error_message", "started_at", "completed_at", "created_at", "updated_at"],
                  "filter": { "workflow": { "organization": { "members": { "user_id": { "_eq": "X-Hasura-User-Id" } } } } }
                }
              }
            ]
          },
          {
            "table": { "schema": "public", "name": "step_runs" },
            "object_relationships": [
              { "name": "workflow_run", "using": { "foreign_key_constraint_on": "workflow_run_id" } }
            ],
            "select_permissions": [
              {
                "role": "owner",
                "permission": {
                  "columns": ["id", "workflow_run_id", "step_id", "step_order", "step_name", "step_type", "status", "input", "output", "error", "attempt_count", "approved_by", "approved_at", "started_at", "completed_at", "created_at", "updated_at"],
                  "filter": { "workflow_run": { "workflow": { "organization": { "members": { "user_id": { "_eq": "X-Hasura-User-Id" } } } } } }
                }
              },
              {
                "role": "editor",
                "permission": {
                  "columns": ["id", "workflow_run_id", "step_id", "step_order", "step_name", "step_type", "status", "input", "output", "error", "attempt_count", "approved_by", "approved_at", "started_at", "completed_at", "created_at", "updated_at"],
                  "filter": { "workflow_run": { "workflow": { "organization": { "members": { "user_id": { "_eq": "X-Hasura-User-Id" } } } } } }
                }
              },
              {
                "role": "viewer",
                "permission": {
                  "columns": ["id", "workflow_run_id", "step_id", "step_order", "step_name", "step_type", "status", "input", "output", "error", "attempt_count", "approved_by", "approved_at", "started_at", "completed_at", "created_at", "updated_at"],
                  "filter": { "workflow_run": { "workflow": { "organization": { "members": { "user_id": { "_eq": "X-Hasura-User-Id" } } } } } }
                }
              }
            ]
          }
        ]
      }
    ],
    "actions": [
      {
        "name": "triggerWorkflowRun",
        "definition": {
          "kind": "synchronous",
          "handler": "{{ACTION_HANDLER_URL}}/api/actions/trigger",
          "forward_client_headers": true
        },
        "permissions": [
          { "role": "owner" },
          { "role": "editor" }
        ]
      },
      {
        "name": "approveStep",
        "definition": {
          "kind": "synchronous",
          "handler": "{{ACTION_HANDLER_URL}}/api/actions/approve",
          "forward_client_headers": true
        },
        "permissions": [
          { "role": "owner" },
          { "role": "editor" }
        ]
      }
    ]
  }
}
